# Octopus Frontend Environment Configuration

# Mock API Mode
# Set to "true" to use mock data instead of real backend API
# Useful for development without running the backend
VITE_MOCK_API=false

# Backend API Base URL (optional)
# Override the default API base path if needed
# Default: /api/v1 (proxied to backend via Vite dev server)
# VITE_API_BASE_URL=/api/v1

# Backend Host for Vite Proxy (development only)
# Default: http://localhost:8888
# Set to actual backend URL when integrating with backend smoke tests
# VITE_BACKEND_URL=http://localhost:8888
